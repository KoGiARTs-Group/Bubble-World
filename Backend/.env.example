PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:1122@localhost:5432/bubbleworld
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_SECRET=0Ps2y7jOTbkmJUUWiDam1IB8PmeKjkkY9SLExkeH6vk
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

PAIRING_CODE_EXPIRY_MINUTES=5
PAIRING_RATE_LIMIT_PER_HOUR=10

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

AP_PASSIVE_INTERVAL_HOURS=24
AP_DAILY_PASSIVE_AMOUNT=1
AP_STARTING_BALANCE=100
AP_INTERVENTION_COST=30

BCRYPT_ROUNDS=12

# AWS Bedrock (Soulform brain / chat)
# Leave keys empty to run in mock mode (no external calls)
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.meta.llama3-1-8b-instruct-v1:0
BEDROCK_MAX_GEN_LEN=250
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9
BEDROCK_TIMEOUT_MS=30000
BRAIN_MAX_RETRIES=2
BRAIN_TICK_MAX_RETRIES=1
# Brain tick cadence served to the client via GET /api/v1/ai/status (client applies it)
BRAIN_TICK_SECONDS=5

# Shared secret for POST /api/v1/ai/chat (Unity sends it as x-api-key).
# Must match SoulformBrainConfig.ApiKey in the Unity client.
# Leave empty to disable the check (local dev only — never in production).
BRAIN_API_KEY=

# Companion app listings + phone-reachable backend URL.
# The "Get the app" QR on Unity's Link Companion App screen points at
# GET /app/download, which 302-redirects scanners by device type:
# Android -> GOOGLE_PLAY_URL, iOS -> APP_STORE_URL, desktop -> chooser page.
# PUBLIC_BASE_URL is what QR payloads use so phones can reach this server
# even when the game client connects via localhost — set it to your LAN IP
# (e.g. http://192.168.1.20:3000) for demos, or the deployed URL later.
# All three may stay empty (QR then serves a "coming soon" page).
GOOGLE_PLAY_URL=
APP_STORE_URL=
PUBLIC_BASE_URL=
